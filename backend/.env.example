APP_NAME=ANOT
APP_ENV=production
# Gere uma chave real com: php artisan key:generate --show
APP_KEY=base64:GERE_COM_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://api.anot.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR_BR

# IMPORTANTE: Nunca versione senhas ou chaves reais.
# Se qualquer APP_KEY ou DB_PASSWORD tiver sido versionada anteriormente, ela DEVE ser rotacionada no provedor de hospedagem.

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Configuração de Banco de Dados de Produção (PostgreSQL Gerenciado)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anot
DB_USERNAME=anot_user
# Senha obrigatória; defina uma senha forte apenas no .env local/provedor de segredos.
DB_PASSWORD=troque-por-uma-senha-forte

# Sessão e Cache (Database / Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Configuração de E-mail (Servidor SMTP de Produção)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=usuario-smtp-de-exemplo
MAIL_PASSWORD=senha-smtp-de-exemplo
MAIL_FROM_ADDRESS="notificacoes@anot.app"
MAIL_FROM_NAME="${APP_NAME}"
