{
  "expo": {
    "name": "ANOT",
    "slug": "anot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0e2f5a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anot.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e2f5a"
      },
      "package": "com.anot.app"
    },
    "plugins": ["expo-font"],
    "sdkVersion": "54.0.0"
  }
}
